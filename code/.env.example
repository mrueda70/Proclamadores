# Copy this file to .env for local development (`vercel dev` reads it automatically).
# In production, set these as Environment Variables in the Vercel project settings instead.

# Supabase Postgres connection string — use the "Connection pooling" string
# (Session/Transaction pooler, port 6543), NOT the direct connection.
# Found in Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Google Gemini API key, used to generate Lectio Divina and suggested songs
GEMINI_API_KEY=

# Resend API key, used to email the admin PIN on failed login attempts
RESEND_API_KEY=
